set tabsize 4
set softwrap
set nohelp
set autoindent

set titlecolor white,red
set selectedcolor white,blue
set numbercolor white,blue

# Useful Keybinds
bind ^b mark main 			# CTRL + b | Mark
bind ^c copy main			# CTRL + c | Copy
bind ^v paste main          # CTRL + v | Paste
bind ^s savefile main       # CTRL + s | Savefile (W/o Prompt)
bind ^r replace main        # CTRL + r | Replace
bind ^z undo main           # CTRL + z | Undo
bind ^y redo main           # CTRL + y | Redo
bind ^t cut main            # CTRL + p | Cut
bind ^f whereis main        # CTRL + f | Search

# Comment Out Line
bind ^/ comment main

# Word Jumping
bind ^p nextword main       # CTRL + o | Goto Next Word
bind ^o prevword main       # CTRL + p | Goto Previous Word
bind M-p nextpage main 		# CTRL + j | Goto Next Page
bind M-o prevpage main		# CTRL + u | Goto Previous Page

# ASM/S Files
syntax "ASM" "\.(S|s|asm)$"
magic "assembler source"
comment "//"

color brightblue "\<(mov|jae|add|sub|mul|div|xor|and|or|not|jmp|je|jne|call|ret|push|pop|lea|cmp|inc|dec)\>"
color brightgreen "\<([rre]?[abcd]x|[rre]?[sd]i|[rre]?[sb]p|r[0-9]+)\>"
color blue "0x[0-9A-Fa-f]+"
color yellow "\b[0-9]+\b"

color red "\<[A-Z_]{2,}\>"
color brightgreen "\.(data|subsection|text)"
color green "\.(align|file|globl|global|hidden|section|size|type|weak)"
color brightyellow "\.(ascii|asciz|byte|double|float|hword|int|long|short|single|struct|word)"
icolor brightred "^[[:space:]]*[.0-9A-Z_]*:"
color brightcyan "^[[:space:]]*#[[:space:]]*(define|undef|include|ifn?def|endif|elif|else|if|warning|error)"

color brightcyan "<[^= 	]*>" ""(\\.|[^"])*""
color brightcyan start=""(\\.|[^"])*\\[[:space:]]*$" end="^(\\.|[^"])*""

color brightblue "^\s*//.*"
color brightblue start="/\*" end="\*/"

color ,green "[[:space:]]+$"

# C/H Files
syntax "C" "\.(c(c|pp|xx)?|C)$" "\.(h(h|pp|xx)?|H)$" "\.ii?$" "\.(def)$" "\.ino"
magic "^(C|C\+\+) (source|program)"                                                                                                                 comment "//"

# Custom Types
color red "\<(i8|i16|i32|i64|u8|u16|u32|u64|iArr|sArr|none|any|fn_t|handler_t|str|arr|sock_t|len_t|pos_t|fd_t|size_t|heap_t|i8|i16|i32|u8|u16|u32)\>"

color brightyellow "\<[a-zA-Z_][a-zA-Z0-9_]*[[:space:]]*\("
color green "\<[A-Z_][0-9A-Z_]+\>"
color red "\<(float|double|bool|char|wchar_t|int|short|long|sizeof|enum|void|static|const|struct|union|typedef|extern|(un)?signed|inline)\>"
color green "\<((char(16|32))|((u_?)?int(_fast|_least)?(8|16|32|64))|u?int(max|ptr))_t\>"
color green "\<(class|namespace|template|public|protected|private|typename|this|friend|virtual|using|mutable|volatile|register|explicit)\>"
color green "\<(for|if|while|do|else|case|default|switch)\>"
color green "\<(try|throw|catch|operator|new|delete)\>"
color green "\<((const|dynamic|reinterpret|static)_cast)\>"
color green "\<(alignas|alignof|asm|auto|compl|concept|constexpr|decltype|export|noexcept|nullptr|requires|static_assert|thread_local|typeid|override|final)\>"
color green "\<(and|and_eq|bitand|bitor|not|not_eq|or|or_eq|xor|xor_eq)\>"
color brightmagenta "\<(goto|continue|break|return)\>"
color red "^[[:space:]]*#[[:space:]]*(define|include|(un|ifn?)def|endif|el(if|se)|if|warning|error)"
color brightmagenta "'([^'\]|(\\["'abfnrtv\\]))'" "'\\(([0-3]?[0-7]{1,2}))'" "'\\x[0-9A-Fa-f]{1,2}'"

# GCC
color green "__attribute__[[:space:]]*\(\([^)]*\)\)" "__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"

color yellow "[.:;,+*|=!\%]" "<" ">" "/" "-" "&"
color magenta "[(){}]" "\[" "\]"


## String highlighting
color cyan "<[^= 	]*>" ""(\\.|[^"])*""

color yellow "%(\#|(0-+))?(hh|h|l|ll|q|L|j|z|Z|t)?[A-Za-z]" "%%"

color magenta "//.*"
color magenta start="/\*" skip="[\"']" end="\*/"

color magenta "@param [a-zA-Z_][a-z0-9A-Z_]+"
color magenta "@return"
color magenta "@author.*"

color ,green "[[:space:]]+$"
